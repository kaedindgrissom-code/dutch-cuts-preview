# Public site URL (canonical, sitemap, OG). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://dutchcuts.com

# Plausible analytics domain. Leave empty to disable tracking entirely.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Booksy website widget script src, copied by the owner from
# Booksy Biz → Business Settings → Online Booking → Your Website. Optional.
NEXT_PUBLIC_BOOKSY_WIDGET_SRC=

# --- Phase two (BookedIQ receptionist) — server-side only, never NEXT_PUBLIC ---
# RETELL_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
